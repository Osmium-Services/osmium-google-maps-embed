{
    "id": "google-maps-embed",
    "name": "Google Maps Embed",
    "version": "2.1.1",
    "description": "Google Maps Embed (a single place in an iframe): named maps managed in admin, for a theme to show anywhere, found by slug",
    "category": "content",
    "website": "https://developers.google.com/maps/documentation/embed",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },
    "autoload": [
        "models"
    ],
    "csp": {
        "frame-src": [
            "https://www.google.com"
        ]
    },
    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "google-maps-embed",
                    "label": "Google Maps Embed",
                    "icon": "bx bx-map",
                    "route": "admin/google-maps-embed",
                    "activePattern": "admin/google-maps-embed*",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/google-maps-embed": {
                "controller": "controllers/GoogleMapsEmbedController.php",
                "class": "Osmium\\Services\\GoogleMapsEmbed\\Controllers\\GoogleMapsEmbedController",
                "method": "index",
                "title": "Google Maps Embed"
            },
            "admin/google-maps-embed/edit": {
                "controller": "controllers/GoogleMapsEmbedController.php",
                "class": "Osmium\\Services\\GoogleMapsEmbed\\Controllers\\GoogleMapsEmbedController",
                "method": "edit",
                "title": "Edit Map"
            },
            "admin/google-maps-embed/action": {
                "controller": "controllers/GoogleMapsEmbedController.php",
                "class": "Osmium\\Services\\GoogleMapsEmbed\\Controllers\\GoogleMapsEmbedController",
                "method": "action"
            }
        }
    },
    "setup": {
        "postInstallNote": "Add a map under Content > Google Maps Embed (Google Maps > Share > Embed a map; copy only the src URL, not the whole iframe), then show it from a theme controller: $maps = new \\Osmium\\Services\\GoogleMapsEmbed\\Models\\GoogleMapsEmbeds($this->osmium->dataSource); $map = $maps->get('your-slug'); The theme prints the iframe (src = $map['url'], escaped) when $map is not null. Each edit page shows the snippet for its own map. The iframe loads Google immediately, with no consent step."
    },
    "migrations": "migrations/"
}

{
    "id": "google-maps-embed",
    "name": "Google Maps Embed",
    "version": "1.1.0",
    "description": "Google Maps Embed (a single place in an iframe) for a theme to place anywhere (e.g. a contact page), from one admin-editable embed URL",
    "category": "content",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",

    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },

    "autoload": [
        "models"
    ],

    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "google-maps-embed",
                    "label": "Google Maps Embed",
                    "icon": "bx bx-map",
                    "route": "admin/settings/google-maps-embed",
                    "activePattern": "admin/settings/google-maps-embed",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/settings/google-maps-embed": {
                "controller": "controllers/GoogleMapsEmbedController.php",
                "class": "Osmium\\Services\\GoogleMapsEmbed\\Controllers\\GoogleMapsEmbedController",
                "method": "index",
                "title": "Google Maps Embed"
            }
        }
    },

    "frontend": {
        "themeBlocks": [
            {
                "hook": "map",
                "file": "theme/google-maps-embed.phtml"
            }
        ]
    },

    "setup": {
        "postInstallNote": "Paste the embed URL on the Google Maps Embed settings page (Google Maps > Share > Embed a map; copy only the src URL, not the whole iframe). Then place the map in a theme with <?php $template['serviceBlock']('map'); ?> where it should appear, e.g. the contact page. Nothing renders until a URL is saved. The iframe loads Google immediately, with no consent step."
    }
}
